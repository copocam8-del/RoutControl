# Copiar a .env y ajustar. Todos los valores tienen un default de desarrollo en infra/docker-compose.yml.

# Marca (provisoria: nunca escribirla fija en el código)
APP_NAME=RouteControl
APP_URL=http://localhost:5173
PANEL_URL=http://localhost:5174
API_URL=http://localhost:8000

# Django
DJANGO_SECRET_KEY=cambiar-en-cada-entorno
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL
POSTGRES_PASSWORD=postgres-dev           # superusuario: solo lo usa el script de inicio del contenedor
DB_NAME=routcontrol
DB_HOST=db
DB_PORT=5432
DB_OWNER_USER=rc_owner                   # dueño de las tablas: migraciones
DB_OWNER_PASSWORD=rc_owner-dev
DB_APP_USER=rc_app                       # la aplicación: sin superusuario, sin BYPASSRLS, no es dueño
DB_APP_PASSWORD=rc_app-dev

# Cookie del refresh token
# Desarrollo (proxy de Vite, mismo origen): SameSite=Lax, Secure=0, sin dominio.
# Producción (app./panel. -> api., mismo sitio): Secure=1, SameSite=Lax, sin dominio (cookie solo de api.).
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_DOMAIN=
# Orígenes que pueden llamar a la API con credenciales (producción: https://app.<dominio>,https://panel.<dominio>)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# Tracking: horas que el token sigue aceptando puntos (grabados dentro de la jornada) después del
# fin. Se puede pisar por empresa con Organization.settings["tracking_token_grace_hours"].
TRACKING_TOKEN_GRACE_AFTER_END_HOURS=72

# Datos de demostración (solo con DJANGO_DEBUG=1)
DEMO_PASSWORD=routcontrol-demo
