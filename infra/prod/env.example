# Ejemplo de infra/prod/.env. install.sh lo genera solo, con contraseñas aleatorias.
APP_NAME=RouteControl
# Tres subdominios con registro DNS (A o AAAA) hacia el servidor.
APP_DOMAIN=app.midominio.com
PANEL_DOMAIN=panel.midominio.com
API_DOMAIN=api.midominio.com
# Para el certificado HTTPS (Let's Encrypt avisa ahí si algo falla).
ACME_EMAIL=yo@midominio.com
# Secretos: al menos 32 caracteres aleatorios cada uno.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Copias diarias: hora local y cuántos días se guardan.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
TZ=America/Argentina/Buenos_Aires
# Opcional: otra imagen de PostGIS (por defecto imresamu/postgis:16-3.5, x86 y ARM).
# POSTGIS_IMAGE=
